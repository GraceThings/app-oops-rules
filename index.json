{
  "name": "App Oops Official Rules",
  "repoUrl": "https://github.com/GraceThings/app-oops-rules",
  "version": 1,
  "updatedAt": "2026-11-12",
  "rules": [
    {
      "id": "anti-shake-clipboard",
      "packageName": "com.taobao.taobao",
      "title": "防摇一摇广告 + 拦截读取剪贴板",
      "description": "禁用运动与高采样率传感器防止开屏摇一摇跳转，并拦截后台偷读剪贴板（保留手动复制功能）。",
      "author": "GraceThings",
      "level": "balanced",
      "recommended": true,
      "updatedAt": "2026-11-12",
      "path": "rules/com.taobao.taobao/anti-shake-clipboard.json",
      "ops": {
        "BODY_SENSORS": "IGNORE",
        "HIGH_SAMPLING_RATE_SENSORS": "IGNORE",
        "ACTIVITY_RECOGNITION": "IGNORE",
        "READ_CLIPBOARD": "IGNORE"
      }
    },
    {
      "id": "gentle-no-shake",
      "packageName": "com.tencent.mm",
      "title": "温和防摇一摇与剪贴板偷窥（不影响消息推送）",
      "description": "仅限制运动传感器及可选读取应用列表，不限制后台运行和 WakeLock，保障即时消息接收。",
      "author": "GraceThings",
      "level": "gentle",
      "recommended": true,
      "updatedAt": "2026-11-12",
      "path": "rules/com.tencent.mm/gentle-no-shake.json",
      "ops": {
        "BODY_SENSORS": "IGNORE",
        "HIGH_SAMPLING_RATE_SENSORS": "IGNORE",
        "QUERY_ALL_PACKAGES": "IGNORE"
      }
    }
  ]
}
